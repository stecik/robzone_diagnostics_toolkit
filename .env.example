# Copy to `.env` (which is gitignored) for local secrets. Never commit `.env`.
#
# robzone-diag does not read these variables yet. They are what the planned
# read-only client for the HCT Robot LAN protocol (TCP 8888) will need.
# All three values appear in the "control" object of the RobZone app's requests
# to the robot (see research/experiments/02-app-traffic-capture.md).
#
# ROBZONE_DIAG_HOST=192.168.x.x
# ROBZONE_DIAG_AUTH_CODE=
# ROBZONE_DIAG_DEVICE_ID=
