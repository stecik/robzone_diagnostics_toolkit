# Copy to `.env` (which is gitignored) for local secrets. Never commit `.env`.
#
# robzone-diag does not read any variables yet. This file documents where
# device secrets will live once a protocol client needs them, for example:
#
# ROBZONE_DIAG_HOST=192.168.x.x
# ROBZONE_DIAG_TUYA_DEVICE_ID=
# ROBZONE_DIAG_TUYA_LOCAL_KEY=
